.claude/settings.local.json
lib/*.dll
# Kafka's native library, downloaded by Import-KfkLibrary. Windows and Linux both put their build
# here, so this directory holds a .so as well as the .dll - never commit either.
lib/*.so
data/timesheets/*.xlsx
data/stackexchange/*.xml
data/geodata/*.gpx
data/geodata/*/*.gpx
data/geodata/*.geojson
data/projectstatus/*.xlsx

# 05_sample_data_setup.ps1 downloads to <name>.part and renames when the file is complete,
# so one of these is only ever left behind by a download that was interrupted
data/**/*.part
