{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(wsl --list:*)",
      "Bash(wsl --status)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git remote:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git blame:*)",
      "PowerShell(docker ps:*)",
      "PowerShell(docker logs:*)",
      "PowerShell(docker inspect:*)",
      "PowerShell(docker compose ps:*)",
      "PowerShell(docker compose logs:*)",
      "PowerShell(docker compose config:*)",
      "PowerShell(Get-Module:*)",
      "PowerShell(Get-Command:*)",
      "PowerShell(Get-Help:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Invoke-ScriptAnalyzer:*)"
    ],
    "deny": [
      "Bash(wsl --shutdown)",
      "Bash(wsl --unregister:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker rm:*)",
      "Bash(docker stop:*)",
      "Bash(docker volume rm:*)",
      "PowerShell(wsl --shutdown)",
      "PowerShell(wsl --unregister:*)",
      "PowerShell(docker compose up:*)",
      "PowerShell(docker compose down:*)",
      "PowerShell(docker rm:*)",
      "PowerShell(docker stop:*)",
      "PowerShell(docker volume rm:*)",
      "Read(./lib/*.dll)",
      "Read(./data/**/*.xlsx)",
      "Read(./data/**/*.xml)",
      "Read(./data/**/*.gpx)",
      "Read(./data/**/*.geojson)"
    ]
  }
}
